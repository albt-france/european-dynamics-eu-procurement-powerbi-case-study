/// Procurement procedure (legacy TED and eForms codes mapped to one list).
table DimProcedure
	lineageTag: ac809800-cd7f-5e6f-a987-a87c0ef5c1bb

	column ProcedureKey
		dataType: int64
		isHidden
		lineageTag: 980f1b12-8c2c-5ce2-ace6-60f0f025610b
		summarizeBy: none
		sourceColumn: ProcedureKey

	column ProcedureLabel
		dataType: string
		lineageTag: 7a9f3fdd-e7fb-56ff-8029-806b93fc8b27
		summarizeBy: none
		sourceColumn: ProcedureLabel
		sortByColumn: SortOrder

	column ProcedureFamily
		dataType: string
		lineageTag: 514a602c-7628-5637-b4ec-dd538e128cd4
		summarizeBy: none
		sourceColumn: ProcedureFamily

	column SortOrder
		dataType: int64
		isHidden
		formatString: 0
		lineageTag: 699dbc7a-af86-5339-b85c-0ee45f959e3e
		summarizeBy: none
		sourceColumn: SortOrder

	partition DimProcedure = m
		mode: import
		source =
				// DimProcedure: PUBLIC DATA (TED), star schema dwh
				// Source: SQL Server view pbi.vDimProcedure (sql/05_views_powerbi.sql). Every step folds to SQL Server:
				// right-click the last step > View Native Query shows a single SELECT. The same M runs unchanged in a
				// Power BI dataflow (Power Query Online, through the on-premises data gateway): see docs/DATAFLOWS.md.
				let
				    Source = Sql.Database(ServerName, DatabaseName),
				    View = Source{[Schema = "pbi", Item = "vDimProcedure"]}[Data],
				    Selected = Table.SelectColumns(View, {"ProcedureKey", "ProcedureLabel", "ProcedureFamily", "SortOrder"})
				in
				    Selected


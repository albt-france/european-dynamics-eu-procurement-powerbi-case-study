/// European Dynamics entities after name resolution (0 = other supplier).
table DimEntity
	lineageTag: 8fe2cbd4-9a21-5436-81fa-a3997bd4cc9a

	column EntityKey
		dataType: int64
		isHidden
		lineageTag: 38ce0a05-24a0-524f-ad4f-00abf2ad7b4e
		summarizeBy: none
		sourceColumn: EntityKey

	column EntityCode
		dataType: string
		lineageTag: 2f260cf6-3ca1-5dbd-9649-82b5308f07f8
		summarizeBy: none
		sourceColumn: EntityCode

	column EntityName
		dataType: string
		lineageTag: 87e0c8b1-661b-58d0-b13d-efe776244274
		summarizeBy: none
		sourceColumn: EntityName

	column EntityKind
		dataType: string
		lineageTag: 2d95ab1a-91f2-518c-8b39-bdfaf6d714d3
		summarizeBy: none
		sourceColumn: EntityKind

	column IsED
		dataType: boolean
		lineageTag: 74da2fda-ff97-54cd-b027-061dd5690a66
		summarizeBy: none
		sourceColumn: IsED

	partition DimEntity = m
		mode: import
		source =
				// DimEntity: PUBLIC DATA (TED), star schema dwh
				// Source: SQL Server view pbi.vDimEntity (sql/05_views_powerbi.sql). Every step folds to SQL Server:
				// right-click the last step > View Native Query shows a single SELECT. The same M runs unchanged in a
				// Power BI dataflow (Power Query Online, through the on-premises data gateway): see docs/DATAFLOWS.md.
				let
				    Source = Sql.Database(ServerName, DatabaseName),
				    View = Source{[Schema = "pbi", Item = "vDimEntity"]}[Data],
				    Selected = Table.SelectColumns(View, {"EntityKey", "EntityCode", "EntityName", "EntityKind", "IsED"})
				in
				    Selected


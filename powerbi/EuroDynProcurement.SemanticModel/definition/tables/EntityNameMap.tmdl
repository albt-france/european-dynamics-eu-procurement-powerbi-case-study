/// Audit of name resolution: raw spelling -> entity (documentation page).
table EntityNameMap
	lineageTag: 9304a218-b6b4-5b93-b276-57d45305b6e0
	isHidden

	column RawName
		dataType: string
		lineageTag: 97c694bd-1fe5-5f75-a9a0-102b9c88d48a
		summarizeBy: none
		sourceColumn: RawName

	column EntityName
		dataType: string
		lineageTag: 6b0e1059-1106-5642-aacc-08d6d28662a6
		summarizeBy: none
		sourceColumn: EntityName

	column MatchedPattern
		dataType: string
		lineageTag: 17aaa8eb-56e9-5b31-9f1c-019265a49696
		summarizeBy: none
		sourceColumn: MatchedPattern

	column SourceSystem
		dataType: string
		lineageTag: f0bf1a53-51b7-5f18-89db-4ab7eb5350ea
		summarizeBy: none
		sourceColumn: SourceSystem

	column Occurrences
		dataType: int64
		formatString: #,0
		lineageTag: abce4596-e04b-500b-ab28-00323f56eb27
		summarizeBy: none
		sourceColumn: Occurrences

	partition EntityNameMap = m
		mode: import
		source =
				// EntityNameMap: PUBLIC DATA (TED), star schema dwh
				// Source: SQL Server view pbi.vEntityNameMap (sql/05_views_powerbi.sql). Every step folds to SQL Server:
				// right-click the last step > View Native Query shows a single SELECT. The same M runs unchanged in a
				// Power BI dataflow (Power Query Online, through the on-premises data gateway): see docs/DATAFLOWS.md.
				let
				    Source = Sql.Database(ServerName, DatabaseName),
				    View = Source{[Schema = "pbi", Item = "vEntityNameMap"]}[Data],
				    Selected = Table.SelectColumns(View, {"RawName", "EntityName", "MatchedPattern", "SourceSystem", "Occurrences"})
				in
				    Selected


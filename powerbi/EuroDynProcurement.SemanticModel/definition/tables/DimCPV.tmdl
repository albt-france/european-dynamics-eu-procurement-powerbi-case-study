/// Common Procurement Vocabulary, hierarchy Division > Group > Class > Code.
table DimCPV
	lineageTag: ff192f43-8e18-5eec-8dcb-880c21ed3326

	column CpvKey
		dataType: int64
		isHidden
		lineageTag: d93dffcd-65d7-5194-bd18-ee134135361c
		summarizeBy: none
		sourceColumn: CpvKey

	column CpvCode
		dataType: string
		lineageTag: 9469e70f-031e-55de-a50d-0a34286463c8
		summarizeBy: none
		sourceColumn: CpvCode

	column CpvLabel
		dataType: string
		lineageTag: ccedcc64-2999-5188-9aa8-64eeedf8dffc
		summarizeBy: none
		sourceColumn: CpvLabel

	column Division
		dataType: string
		lineageTag: 548ad512-4f39-55fd-82bf-4e369794cfa9
		summarizeBy: none
		sourceColumn: Division

	column Group
		dataType: string
		lineageTag: 59a525de-84d3-5dc3-bee0-7a173aa5343e
		summarizeBy: none
		sourceColumn: Group

	column Class
		dataType: string
		lineageTag: ef1d42b1-f1c5-5f3b-99bf-6028eaa5d0ed
		summarizeBy: none
		sourceColumn: Class

	column CpvCodeLabel
		dataType: string
		lineageTag: dde63b6d-0623-5f66-991e-0b2c2c98fda0

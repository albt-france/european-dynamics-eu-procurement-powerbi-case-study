/// Commission departments (FTS).
table DimDepartment
	lineageTag: d2075f7a-852e-5b90-bcd6-7fc06b397018

	column Department
		dataType: string
		lineageTag: a81156b9-814d-5d10-b1f8-43f9d401c87a
		summarizeBy: none
		sourceColumn: Department

	column DepartmentCode
		dataType: string
		lineageTag: b3ec8680-bfa6-5e56-b69e-8f3637b48c98
		summarizeBy: none
		sourceColumn: DepartmentCode

	column DepartmentName
		dataType: string
		lineageTag: ac09771c-3bcd-59af-add9-ce34147f8805
		summarizeBy: none
		sourceColumn: DepartmentName

	partition DimDepartment = m
		mode: import
		source =
				// DimDepartment: Commission departments (Directorates-General, executive agencies) found in FtsStaging.
				let
				    Source = Table.Distinct(Table.SelectColumns(FtsStaging, {"department"})),
				    Code = Table.AddColumn(Source, "DepartmentCode", each Text.Trim(Text.BeforeDelimiter([department], " - ")), type text),
				    Name = Table.AddColumn(Code, "DepartmentName", each Text.Trim(Text.AfterDelimiter([department], " - ")), type text),
				    Renamed = Table.RenameColumns(Name, {{"department", "Department"}})
				in
				    Renamed


{
  "$schema": "https://developer.microsoft.com/json-schemas/fabric/item/report/definition/visualContainer/2.4.0/schema.json",
  "name": "bar_axis",
  "position": {
    "x": 32,
    "y": 400,
    "z": 12000,
    "height": 304,
    "width": 918,
    "tabOrder": 12000
  },
  "visual": {
    "visualType": "clusteredBarChart",
    "query": {
      "queryState": {
        "Category": {
          "projections": [
            {
              "field": {
                "Column": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "Axis"
                    }
                  },
                  "Property": "Axis"
                }
              },
              "queryRef": "Axis.Axis",
              "nativeQueryRef": "Axis"
            }
          ]
        },
        "Y": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "ED Awards"
                }
              },
              "queryRef": "_Measures.ED Awards",
              "nativeQueryRef": "ED Awards"
            },
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "ED Buyers"
                }
              },
              "queryRef": "_Measures.ED Buyers",
              "nativeQueryRef": "ED Buyers"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "objects": {
      "labels": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "color": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#0B0B0B'"
                    }
                  }
                }
              }
            }
          }
        }
      ],
      "dataPoint": [
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#2A78D6'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.ED Awards"
          }
        },
        {
          "properties": {
            "fill": {
              "solid": {
                "color": {
                  "expr": {
                    "Literal": {
                      "Value": "'#B4B2A9'"
                    }
                  }
                }
              }
            }
          },
          "selector": {
            "metadata": "_Measures.ED Buyers"
          }
        }
      ]
    },
    "visualContainerObjects": {
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Awards and buyers by the selected axis'"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Bar chart of awards and distinct buyers by the axis chosen in the ''Compare by'' slicer.'"
                }
              }
            }
          }
        }
      ]
    }
  }
}
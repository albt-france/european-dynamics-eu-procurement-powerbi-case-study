                }
              },
              "queryRef": "DimCountry.CountryName",
              "nativeQueryRef": "CountryName"
            }
          ]
        },
        "Size": {
          "projections": [
            {
              "field": {
                "Measure": {
                  "Expression": {
                    "SourceRef": {
                      "Entity": "_Measures"
                    }
                  },
                  "Property": "ED Awards"
                }
              },
              "queryRef": "_Measures.ED Awards",
              "nativeQueryRef": "ED Awards"
            }
          ]
        }
      }
    },
    "drillFilterOtherVisuals": true,
    "visualContainerObjects": {
      "subTitle": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "false"
                }
              }
            }
          }
        }
      ],
      "title": [
        {
          "properties": {
            "show": {
              "expr": {
                "Literal": {
                  "Value": "true"
                }
              }
            },
            "text": {
              "expr": {
                "Literal": {
                  "Value": "'Where the buyers are (bubble size = awards)'"
                }
              }
            }
          }
        }
      ],
      "general": [
        {
          "properties": {
            "altText": {
              "expr": {
                "Literal": {
                  "Value": "'Map of buyer countries, bubble size proportional to European Dynamics awards. EU agencies count in their host country (e.g. Portugal for Lisbon-based agencies). Same figures in the bar chart below.'"
                }
              }
            }
          }
        }
      ]
    }
